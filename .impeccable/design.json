      "html": "<button class=\"ds-btn-primary\">Guardar en el diario</button>",
      "css": ".ds-btn-primary{font-family:system-ui,-apple-system,'Segoe UI',Roboto,sans-serif;background:#CC2E34;color:#fff;border:none;border-radius:14px;min-height:52px;padding:14px 18px;font-size:16px;font-weight:700;box-shadow:0 2px 8px rgba(204,46,52,.22);cursor:pointer;transition:background-color .15s ease,transform .12s ease}.ds-btn-primary:hover{background:#A8242A}.ds-btn-primary:focus-visible{outline:2.5px solid #CC2E34;outline-offset:2px;}.ds-btn-primary:active{transform:scale(.98)}"
    },
